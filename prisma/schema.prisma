// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ADMIN USER
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role      @default(ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  EDITOR
}

// KUNSKAPSBANKEN (BLOGG)
model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  seoTitle        String?
  metaDescription String?
  featuredImage   String?
  content         String    @db.Text
  author          String?
  tags            String[]
  categories      String[]
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  category        String?
  excerpt         String?
  description     String?
  image_url       String?
  author_image    String?
  publish_date    DateTime?
  blocks          Json?

  @@index([slug])
  @@map("blog_posts")
}

// PROJEKT
model Project {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  description     String    @db.Text
  images          String[]  
  client          String?
  category        String?
  result          String?   @db.Text
  ctaText         String?
  ctaLink         String?
  published       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  title           String?
  city            String?
  excerpt         String?
  content         String?   @db.Text
  author          String?
  author_image    String?
  publish_date    DateTime?
  blocks          Json?

  @@index([slug])
  @@map("projects")
}

// FAQ
model FAQ {
  id          String    @id @default(cuid())
  question    String
  answer      String    @db.Text
  category    String?
  order       Int       @default(0)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sort_order  Int       @default(0)

  @@map("faqs")
}

// JOBBA HOS OSS (JOBS)
model JobOpening {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  location        String
  type            String    
  description     String    @db.Text
  requirements    String    @db.Text
  applyLink       String?
  deadline        DateTime?
  published       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  job_type        String?
  excerpt         String?
  content         String?   @db.Text
  blocks          Json?

  @@index([slug])
  @@map("job_openings")
}

// NYHETSBREV (NEWSLETTER SUBSCRIBERS)
model Subscriber {
  id          String    @id @default(cuid())
  email       String    @unique
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("subscribers")
}

// KUNSKAPSBANKEN (KNOWLEDGE POSTS)
model KnowledgePost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?   @db.Text
  content         String?   @db.Text
  blocks          Json?     // För Tiptap block-data
  images          String[]  
  category        String?
  author          String?
  author_image    String?
  published       Boolean   @default(true)
  publish_date    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug])
  @@map("knowledge_posts")
}

// FAQ (FAQ ITEMS)
model FAQItem {
  id          String    @id @default(cuid())
  question    String
  answer      String    @db.Text
  category    String?
  sort_order  Int       @default(0)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("faq_items")
}

// PRISER (PRICE PLANS)
model PricePlan {
  id          String    @id @default(cuid())
  name        String
  price       String
  description String?   @db.Text
  features      String[]
  isPopular     Boolean   @default(false)
  category      String    @default("Privatpersoner")
  campaign_text String?
  sort_order    Int       @default(0)
  published     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("price_plans")
}

// KAMPANJER (CAMPAIGNS)
model Campaign {
  id              String    @id @default(cuid())
  name            String    // Internt namn
  title           String    // Kampanjens rubrik utåt
  description     String?   @db.Text
  discount        String?   // T.ex. "-20%" eller "5000 kr rabatt"
  badgeText       String?   // T.ex. "Tidsbegränsat erbjudande"
  countdownDate   DateTime? // DET KRITISKA FÄLTET: Driver frontend-timern
  ctaText         String?   // Knappens text
  ctaLink         String?   // Knappens länk
  isActive        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("campaigns")
}

// PERSONAL (TEAM)
model Employee {
  id          String    @id @default(cuid())
  name        String
  role        String
  image_url   String?
  sort_order  Int       @default(0)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("employees")
}
